    - target: {fileID: 1675962321474784320, guid: 3b8d5129b54c3124a8011397aec1f40f, type: 3}
      propertyPath: m_text
      value: "Hi Gwendolen,\r\nI\u2019ve prepared the supply order for next month
        based on the requests we received from the research and arcane communications
        teams.\r\nBefore sending it to the suppliers, I just need a quick confirmation
        from you that everything looks correct from a budget perspective.\r\nYou
        can review the order list through the rune here:\r\n"
      objectReference: {fileID: 0}
