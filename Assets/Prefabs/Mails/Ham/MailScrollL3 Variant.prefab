    - target: {fileID: 1675962321474784320, guid: 3b8d5129b54c3124a8011397aec1f40f, type: 3}
      propertyPath: m_text
      value: "Hi Gwendolen,\r\nJust a quick reminder about the coordination meeting
        for the High Wizard\u2019s upcoming crystal intensification projects. I\u2019ve
        placed a tentative meeting in the calendar for Tuesday next week at 10:00,
        so we can go through the communication requirements before the planning session
        later that day.\r\n\r\n\r\nCould you please check if that time works on your
        side and confirm in the calendar invite?\r\nIf the time doesn\u2019t work,
        feel free to suggest another slot and I\u2019ll adjust it.\r\n"
      objectReference: {fileID: 0}
