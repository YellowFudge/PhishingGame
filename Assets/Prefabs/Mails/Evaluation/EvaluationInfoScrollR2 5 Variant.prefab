    - target: {fileID: 7222691419828877991, guid: cdf805fec9c199045ba01bc8b49027ed, type: 3}
      propertyPath: m_text
      value: "Dear customers,\r\n\r\nWe had an incantation incident last week, and
        our tome of customers were lost in the void. It has now come to our attention
        that multiple customers have been receiving scrolls from Cat\u2019s delivery.
        We want to urge you to be careful with these scrolls and ensure you that
        we keep using Broom\u2019s Express for the time being, regardless of the
        repeated delivery issues we have been experiencing with them.\r\n\r\nWe thank
        you for your patience,\r\n\n"
      objectReference: {fileID: 0}
