  m_text: "URL Or Attachment\r\nHidden links and unexpected attachments are common
    phishing tools.\r\n\r\nWhat to do: \nHover over links before clicking and check
    where they really go. Do not open files you did not expect. Visit the official
    site manually instead of using the email link. If the link or file looks suspicious,
    report the email immediately.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 908bf12b09d599749960f1eeb3588c02, type: 2}
